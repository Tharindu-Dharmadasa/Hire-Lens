{
  "name": "hire-lens-backend",
  "version": "0.1.0",
  "description": "HireLens Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "tsx dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "tsx": "^4.23.15",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.10.6",
    "@types/supertest": "^2.0.12",
    "prisma": "7.9.1",
    "supertest": "^6.3.3",
    "tsc-alias": "^1.9.7",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
